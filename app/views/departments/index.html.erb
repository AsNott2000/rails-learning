<h1>Departments#index</h1>
<p>Find me in app/views/departments/index.html.erb</p>
<h1>Departments</h1>

<div id="departments">
  <% @departments.each do |department| %>
    <%= department.id%><br>
    <%= department.department_name %><br>
    <%= department.created_at%><br>
    <%= department.updated_at%><br>
    =========================<br>
  <% end %>
  <div id = "department_by_id">
    <% @departments.each do |department|%>
      <div>
        <%= link_to department.department_name, department_path(department.id)%><br>
      </div>
    <% end %>
  </div>
</div>
